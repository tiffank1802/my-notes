/* ---- Indicateur de synchronisation ----------------------------------- */
.sync-status {
  position: fixed;
  bottom: 12px;
  right: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: rgba(255, 255, 255, 0.95);
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  font-size: 13px;
  line-height: 1.4;
  color: #333;
  z-index: 9999;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.sync-status__dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #aaa;
  flex-shrink: 0;
}

.sync-status__dot--ok {
  background: #2e7d32;
  box-shadow: 0 0 6px rgba(46, 125, 50, 0.4);
}

.sync-status__dot--syncing {
  background: #f57f17;
  animation: sync-pulse 1.2s ease-in-out infinite;
}

.sync-status__dot--error {
  background: #d32f2f;
}

@keyframes sync-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.5; transform: scale(0.75); }
}

.sync-status__label {
  font-weight: 500;
}

.sync-status__user {
  font-weight: 400;
  color: #777;
}

.sync-status__btn {
  padding: 2px 10px;
  border: 1px solid #bbb;
  border-radius: 12px;
  background: #fff;
  font-size: 12px;
  cursor: pointer;
  color: #333;
  transition: background 0.2s;
}

.sync-status__btn:hover:not(:disabled) {
  background: #f0f0f0;
}

.sync-status__btn:disabled {
  opacity: 0.5;
  cursor: default;
}

/* ---- Structure de la page (canvas plein écran) ----------------------- */
html {
  height: 100%;
}

body {
  margin: 0;
  overflow: hidden;
  height: 100%;
}

#root {
  width: 100%;
  max-width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  display: block;
  min-height: auto;
  border: none;
  box-sizing: border-box;
  text-align: left;
}

.app-container {
  width: 100%;
  height: 100%;
}